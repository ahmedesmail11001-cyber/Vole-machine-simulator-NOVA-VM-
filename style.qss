/* ===================== NOVA VM theme (from the Figma prototype) =====================
   Colors:  background #07070d | card #0d0d17 | border #1e1e2e
            purple #a78bfa / #5b47b5 | mint #5eead4 | text #f2f2f8 | muted #8a8aa3
   ===================================================================================== */

* {
    font-family: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #f2f2f8;
}

QMainWindow, #centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #14122b, stop:0.22 #0b0b17, stop:1 #07070d);
}

QLabel { background: transparent; }

/* ---------- header ---------- */
#tagLabel      { color: #8b7cf6; font-size: 11px; font-weight: 600; }
#titleLabel    { color: #ffffff; font-size: 46px; font-weight: 800; }
#subtitleLabel { color: #a78bfa; font-size: 17px; font-weight: 600; }

#coreChip { background: transparent; }
#bitBox {
    background: #0f0f1c;
    border: 1px dashed #3b3b58;
    border-radius: 16px;
}
#bitValueLabel   { color: #c4b5fd; font-size: 24px; font-weight: 500; }
#bitCaptionLabel { color: #6b6b85; font-size: 8px; }
#coreStatusLabel { color: #ffffff; font-size: 14px; font-weight: 700; }

/* ---------- small captions ---------- */
QLabel[role="cap"]   { color: #7c7c96; font-size: 10px; font-weight: 700; }
QLabel[role="hint"]  { color: #6b6b85; font-size: 10px; }
QLabel[role="faint"] { color: #55556b; font-size: 9px; }
QLabel[role="green"] { color: #34d399; font-size: 9px; font-weight: 600; }
QLabel[role="footnote"] { color: #8a8aa3; font-size: 9px; }
QLabel[role="footer"]   { color: #3d3d55; font-size: 9px; }
QLabel[role="pcprefix"] { color: #6b6b85; font-size: 12px; }

/* ---------- control bar ---------- */
#controlBar {
    background: #0c0c17;
    border: 1px solid #1e1e2e;
    border-radius: 22px;
}
#pcValueLabel    { color: #ffffff; font-family: "JetBrains Mono", "Cascadia Mono", Consolas, "Courier New", monospace; font-size: 22px; font-weight: 600; }
#cycleValueLabel { color: #ffffff; font-family: "JetBrains Mono", "Cascadia Mono", Consolas, "Courier New", monospace; font-size: 20px; font-weight: 600; }

#runButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6ee7b7, stop:1 #5eead4);
    color: #04332c;
    border: none;
    border-radius: 14px;
    font-weight: 700;
    padding: 0 18px;
}
#runButton:hover    { background: #7ff0c5; }
#runButton:pressed  { background: #4fd8bb; }
#runButton:disabled { background: #17362f; color: #3f7a6d; }

#stepButton {
    background: #14122b;
    color: #c4b5fd;
    border: 1px solid #3b2f80;
    border-radius: 14px;
    font-weight: 600;
    padding: 0 18px;
}
#stepButton:hover    { background: #1d1a3d; }
#stepButton:pressed  { background: #26214f; }
#stepButton:disabled { background: #0e0e18; color: #4a4a62; border-color: #1c1c2b; }

#stopButton {
    background: #111119;
    color: #8a8aa3;
    border: 1px solid #1e1e2e;
    border-radius: 14px;
    font-weight: 600;
    padding: 0 18px;
}
#stopButton:enabled  { color: #fca5a5; border-color: #4a2530; }
#stopButton:disabled { color: #55556b; }

/* ---------- cards ---------- */
QFrame[role="card"] {
    background: #0d0d17;
    border: 1px solid #1e1e2e;
    border-radius: 20px;
}
QFrame[role="cardheader"] {
    background: transparent;
    border: none;
    border-bottom: 1px solid #1a1a28;
    border-radius: 0px;
}
QLabel[role="icon"] {
    background: #16162a;
    border: 1px solid #2a2a45;
    border-radius: 11px;
    color: #a78bfa;
    font-size: 13px;
    font-weight: 700;
}
#outputIcon   { background: #0f2623; border-color: #14463d; color: #5eead4; }
#registerIcon { background: #261f10; border-color: #4a3a14; color: #f5b94a; }
#memoryIcon   { background: #0f2623; border-color: #14463d; color: #5eead4; }

QLabel[role="cardtitle"] { color: #ffffff; font-size: 15px; font-weight: 600; }
QLabel[role="cardsub"]   { color: #7c7c96; font-size: 11px; }

QLabel[role="badge"] {
    background: #241d4a;
    border: 1px solid #4a3d99;
    border-radius: 8px;
    color: #c4b5fd;
    font-size: 10px;
    font-weight: 700;
    padding: 6px 10px;
}
QLabel[role="livedot"]  { color: #34d399; font-size: 8px; }
QLabel[role="livetext"] { color: #34d399; font-size: 8px; font-weight: 700; }
QLabel[role="usedcount"]{ color: #34d399; font-family: "JetBrains Mono", Consolas, monospace; font-size: 16px; font-weight: 700; }

QFrame[role="cardfooter"] {
    background: transparent;
    border: none;
    border-top: 1px solid #1a1a28;
    border-radius: 0px;
}

/* ---------- step indicator ---------- */
#stepsFrame {
    background: #0a0a14;
    border: 1px solid #1e1e2e;
    border-radius: 14px;
}
QLabel[role="stepcircle"] {
    background: #6d5bd0;
    border-radius: 12px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
}
QLabel[role="steptext"] { color: #d8d8e8; font-size: 11px; font-weight: 600; }
QFrame[role="stepline"] { background: #2a2a45; border: none; }

/* ---------- code editor ---------- */
CodeEditor {
    background: #05050b;
    border: 1px solid #2a2a45;
    border-radius: 16px;
    color: #ffffff;
    font-family: "JetBrains Mono", "Cascadia Mono", Consolas, "Courier New", monospace;
    font-size: 14px;
    font-weight: 600;
    padding-top: 6px;
    selection-background-color: #4a3d99;
}

/* ---------- format buttons ---------- */
QPushButton[role="format"] {
    background: #0b0b14;
    border: 1px solid #23233a;
    border-radius: 10px;
    color: #c0c0d4;
    font-weight: 600;
}
QPushButton[role="format"]:hover   { border-color: #3b3b5c; }
QPushButton[role="format"]:checked { background: #2a2352; border: 1px solid #6d5bd0; color: #ffffff; }

/* ---------- load file button ---------- */
#loadFileButton {
    background: #14122b;
    border: 1px solid #3b2f80;
    border-radius: 8px;
    color: #c4b5fd;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 14px;
}
#loadFileButton:hover    { background: #1d1a3d; }
#loadFileButton:pressed  { background: #26214f; }
#loadFileButton:disabled { color: #4a4a62; border-color: #1c1c2b; }

/* ---------- start address + store ---------- */
#addressBox {
    background: #05050b;
    border: 1px solid #23233a;
    border-radius: 12px;
}
#addressEdit {
    background: transparent;
    border: none;
    color: #ffffff;
    font-family: "JetBrains Mono", "Cascadia Mono", Consolas, "Courier New", monospace;
    font-size: 18px;
    font-weight: 700;
}
#addressBox QLabel { font-family: "JetBrains Mono", Consolas, monospace; font-size: 15px; }

#storeButton {
    background: #5646b0;
    border: 1px solid #7a68d8;
    border-radius: 12px;
    color: #ffffff;
    font-weight: 600;
    padding: 0 16px;
}
#storeButton:hover    { background: #6554c4; }
#storeButton:pressed  { background: #4b3c9c; }
#storeButton:disabled { background: #1c1938; border-color: #2a2550; color: #5f5f80; }

/* ---------- output terminal ---------- */
#terminalFrame {
    background: #07140f;
    border: 1px solid #12352c;
    border-radius: 14px;
}
#terminalLabel {
    color: #4ade80;
    font-family: "JetBrains Mono", "Cascadia Mono", Consolas, "Courier New", monospace;
    font-size: 12px;
}

/* ---------- tables (registers + memory) ---------- */
QTableWidget {
    background: transparent;
    border: none;
    gridline-color: transparent;
    outline: 0;
    font-family: "JetBrains Mono", "Cascadia Mono", Consolas, "Courier New", monospace;
    font-size: 15px;
    font-weight: 600;
    alternate-background-color: rgba(255, 255, 255, 6);
}
QTableWidget::item { border: none; padding-left: 8px; background: transparent; }

QHeaderView { background: transparent; border: none; }
QHeaderView::section {
    background: transparent;
    color: #6b6b85;
    border: none;
    border-bottom: 1px solid #1a1a28;
    padding: 9px 8px;
    font-size: 10px;
    font-weight: 700;
    text-align: left;
}

QScrollBar:vertical { background: transparent; width: 8px; margin: 4px 2px; }
QScrollBar::handle:vertical { background: #2a2a3f; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #3b3b5a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 0; }

QToolTip { background: #14142a; color: #ffffff; border: 1px solid #3b3b5c; }
